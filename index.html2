<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Bulb Toggle</title>

  <style>
    body {
      margin: 0;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #111;
      font-family: Arial, sans-serif;
    }

    .container {
      text-align: center;
    }

    img {
      width: 300px;
      border-radius: 12px;
    }

    button {
      margin-top: 20px;
      padding: 12px 24px;
      font-size: 18px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }
  </style>
</head>

<body>

  <div class="container">
    <img id="bulb" src="Screenshot_20260515_122840.jpg" alt="Bulb">

    <br>

    <button id="btn" onclick="changeBulb()">
      Turn On
    </button>
  </div>

  <script>
    let isOn = false;

    function changeBulb() {
      let bulb = document.getElementById("bulb");
      let btn = document.getElementById("btn");

      if (isOn) {
        bulb.src = "Screenshot_20260515_122840.jpg";
        btn.innerText = "Turn On";
        isOn = false;
      } else {
        bulb.src = "";
        btn.innerText = "Turn Of";
        isOn = true;
      }
    }
  </script>

</body>
</html>
